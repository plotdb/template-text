{
  "name": "service",
  "ip": "127.0.0.1",
  "port": 3000,
  "hostname": "sample.service",
  "root": "/Users/user/sample/frontend/web/static/",
  "template_root": "/Users/user/sample/user/template/",
  "thumb_root": "/Users/user/sample/user/thumb/",
  "file_root": "/Users/user/sample/user/file/",
  "cert": {
    "crt": "/Users/user/cert/sample.service/server.crt",
    "key": "/Users/user/cert/sample.service/server.key"
  },
  "nginxCfgDir": "/opt/homebrew/etc/nginx",
  "cache": {
    "path": "sample",
    "name": "sample-cache"
  },
  "enable_hsts": true
}
