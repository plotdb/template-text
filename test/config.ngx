upstream !{name}_api {
  server !{ip}:!{port};
}

# used by @plotdb/registry
proxy_cache_path /tmp/sample-cache/!{cache.path} keys_zone=!{cache.name}:10m levels=1:2 inactive=600s max_size=100m;

server {
  # serve 80 + 443 in the same server block for resolving redirecting issue.
  # see HSTS comments below for more information.
  !{if !enable_hsts? or !enable_hsts => !""
    listen 80;
  ""! else ""}
  listen 443 default_server ssl;

  #listen 443 ssl http2;
  # for IPv6
  #listen [::]:443 ssl http2 ipv6only=on;
  include !{nginxCfgDir}/mime.types;
  server_name !{hostname};
  server_tokens off;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_certificate !{cert.crt};
  ssl_certificate_key !{cert.key};
  root !{root};

  error_page 403 /err/403.html;
  error_page 404 /err/404.html;
  error_page 500 /err/490.html;
  error_page 502 /err/502.html;

  add_header Cross-Origin-Opener-Policy "same-origin" always;
  add_header X-Frame-Options "SAMEORIGIN" always;
  add_header Content-Security-Policy "frame-ancestors 'self'" always;

  location = /err/490 {
    error_page 490 /err/490.html;
    return 490;
  }

  location ~ ^/modules/error/(.*)$ {
    try_files /modules/error/$1 /assets/lib/@servebase/erratum/main/block/$1 =404;
  }

  location ~ ^/(.*\.map)$ {
    expires 365d;
    add_header Pragma public;
    add_header Cache-Control public;
    return 200 '{"sources":[],"sourcesContent":[]}';
  }

  location ~ ^/template/([^/]+)/([^#?].*)$ {
    root !{template_root};
    try_files /$1/static/$2 /$1/static/$2/index.html /$1/web/static/$2 /$1/web/static/$2/index.html =404;
  }

  # TODO we should make this work to offload work from api server
  #location ^~ ^/prj/(.*?)/thumb$ {
  #  try_files @apiserver /assets/img/thumbnail-placeholder.jpg =404;
  #}

  location ~ ^/assets/avatar/(.*)$ {
    try_files /assets/avatar/$1.png /assets/img/avatar.svg =404;
  }

  location ~ ^/ws$ {
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Host $host;
    proxy_pass http://!{name}_api;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_connect_timeout 3600s;
    proxy_send_timeout 3600s;
    proxy_read_timeout 3600s;
  }

  # root for customized org
  location ~ ^/_root/ { return 404; }
  location ~ ^/\.git { return 404; }

  location ~ ^/assets/lib/(.*)$ {
    try_files /assets/lib/$1 /assets/lib/$1/index.html @registry_cache;
  }

  #### generated from @plotdb/registry { ####
  #### NOTE: we rename the entry path `assets/lib` to `registry_cache`,
  ####       so we can check local installed version first.
  # this should be put outside server block, where `<cache>` should be the same with `cache.name` config.
  # proxy_cache_path /tmp/cache keys_zone=<cache>:10m levels=1:2 inactive=600s max_size=100m;

  # requests to path under `internal` are from `X-Accel-Redirect` from registry backend
  # and thus should not hit backend again.


  location ~ ^/ilib/(.*)$ {
    internal;
    root /var/lib/cdn/cache/;
    try_files /assets/lib/$1 /assets/lib/$1/index.html /$1/index.min.js =404;
  }

  # this location is patched manually
  location @registry_cache {
    root /var/lib/cdn/cache/;
    # proxy_cache is file-based. here we use `.reg.404` for pkg-based 404 detection
    # however, we don't know how to invalidate this. So this is not used for now.
    # to use this, we have to use location pattern such as:
    #
    #     location ~ ^/lib/(?<scope>.+)/(?<name>.+)/(?<version>.+)/(?<path>.*)$ { ... }
    #     location ~ ^/lib/(?<name>.+)/(?<version>.+)/(?<path>.*)$ { ... }
    #
    # if (-f /var/lib/cdn/cache/lib/$name/$version/.reg.404) {
    #   return 404 "";
    #   break;
    # }
    try_files /assets/lib/$1 /assets/lib/$1/index.html /assets/lib/$1/index.min.js @registry_backend;
  }

  # a dedicated location for registry_backend so we can use a dedicated server for registry
  # to offload requests from main backend. This is controlled by `upstream` config.
  location @registry_backend {
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Host $http_host;
    proxy_set_header X-NginX-Proxy true;
    proxy_set_header X-Forwarded-Proto $scheme;
    # cache 200 / 404 result for `cache-period` so user can't bombard our backend
    proxy_cache !{cache.name};
    proxy_cache_valid 200 404 10m;
    proxy_pass http://!{name}_api;
  }

  #### } generated from @plotdb/registry ####

  # site-wise directive {
  # for content from site, we consider user custom files first.

  # put resources rule at the top so all resources will match this.
  # note: a similar resource directive below vvv. keep these in sync.
  location ~ ^/site/(.*\.(?:ico|css|js|gif|jpe?g|png|svg|woff|ttf|otf))$ {
    expires 1d;
    add_header 'Pragma' 'public';
    add_header 'Cache-Control' 'public';
    try_files /_root/site/$1 /site/$1 =404;
  }

  location ~ ^/site/(.*)$ {
    try_files /_root/site/$1 /_root/site/$1/index.html =404;
  }
  # } site-wise directive

  # note: a similar resource directive above ^^^. keep these in sync.
  location ~ /(.*\.(?:ico|css|js|gif|jpe?g|png|svg|woff|ttf|otf))$ {
    expires 1d;
    add_header 'Pragma' 'public';
    add_header 'Cache-Control' 'public';
    try_files /$1 /_root/$1 =404;
  }

  location ~ ^/assets/(.*)$ {
    try_files /assets/$1 /assets/$1/index.html;
  }

  location ~ ^/modules/(.*)$ {
    try_files /modules/$1 /modules/$1/index.html =404;
  }

  location ~ ^/(.*)$ {
    try_files /$1 /$1/index.html /_root/$1 /_root/$1/index.html @apiserver;
  }

  # work in progress. TODO check if rule is complete ( including root path `/` )
  #location ~ ^/(api)/(.*)$ {
  #  root /Users/sample/sample/frontend/web/static/;
  #  try_files /$1/$2 /$1/$2/index.html /$1/_root/$2 /$1/_root/$2/index.html @apiserver;
  #}

  location @apiserver {

    # i18n path - save locale in lng and store it in I18n-Locale header.
    #             express server can config i18next-http-middleware to get lng from that header.
    rewrite ^/intl/(?<lng>.*)/(.*) /$2 break;
    proxy_set_header I18n-Locale $lng;

    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Host $http_host;
    proxy_set_header X-NginX-Proxy true;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_pass http://!{name}_api;

    # we use location block instead of error_page directive to handle error 490
    # because cookie wont pass through proxy_intercept_errors to error_page dir.
    proxy_intercept_errors on;

    proxy_redirect off;
    #limit_req zone=api burst=7 nodelay;
  }
}

# HSTS: Below(see source config) is the configuration for HSTS (Http Strict Transport Security)
# Usually we will want to use this for better security,
# however this may cause ERR_TOO_MANY_REDIRECT due to cloudflare configuration issue
# ( https://developers.cloudflare.com/ssl/troubleshooting/too-many-redirects/ )
# thus, by default we serve 80 + 443 through the same server block.
!{if enable_hsts? and enable_hsts => !""
  server {
    listen 80;
    server_name !{hostname};
    add_header Strict-Transport-Security "max-age=16070400; includeSubDomains";
    location / {
      if ($http_user_agent !~* (facebook) ) {
        return 301 https://$host$request_uri;
      }
      root !{root};
    }
    #rewrite     ^   https://$server_name$request_uri? permanent;
  }
""! else ""}
